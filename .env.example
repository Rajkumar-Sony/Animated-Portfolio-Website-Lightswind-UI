# Portfolio environment — copy to .env.local for local dev.
# On Vercel, set these in Project → Settings → Environment Variables.

# ── Frontend (build-time, baked into the bundle) ─────────────────────────────
# Same-origin serverless endpoints in production.
VITE_CONTACT_ENDPOINT=/api/contact
VITE_RESUME_REQUEST_ENDPOINT=/api/resume-request
# Optional: OpenWeather key for the weather widget (leave empty to disable).
VITE_OPENWEATHER_API_KEY=

# ── Backend (runtime) ─────────────────────────────────────────────────────────
ZOHO_MAIL_USER=rajkumar.sony@zohomail.in
ZOHO_MAIL_APP_PASSWORD=
RESUME_OWNER_EMAIL=
# Base URL used in approve/reject links emailed to the owner.
RESUME_SERVER_PUBLIC_URL=https://rajkumarsony.vercel.app
# Public resume link included in the sent resume email.
RESUME_PUBLIC_URL=https://app.box.com/s/5c4liqe7jpyb2gwqpd3oyvtusryndxnq
# HMAC secret signing approve/reject tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
APPROVAL_TOKEN_SECRET=
# Optional: extra CORS origins (comma-separated). Prod + localhost are always allowed.
# ALLOWED_ORIGINS=

# ── Local-only (legacy `npm run dev:resume-server` Node server) ───────────────
RESUME_SERVER_PORT=8787
