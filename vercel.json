{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/approve/:token",
      "destination": "/api/approve/:token"
    },
    {
      "source": "/reject/:token",
      "destination": "/api/reject/:token"
    }
  ],
  "functions": {
    "api/approve/[token].js": {
      "includeFiles": "../public/resume.pdf"
    },
    "api/contact.js": {
      "maxDuration": 15
    },
    "api/resume-request.js": {
      "maxDuration": 15
    },
    "api/reject/[token].js": {
      "maxDuration": 10
    }
  }
}
